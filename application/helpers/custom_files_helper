<?php defined('BASEPATH') or exit('No direct script access allowed');

/**
 * Helper personalizado para manipulação de arquivos/pastas
 */
if (!function_exists('list_folders')) {
    /**
     * Lista subpastas de um caminho
     *
     * @param string $path Caminho (pode ser uploads/ etc.)
     * @return array       Subpastas encontradas
     */
    function list_folders($path)
    {
        $path = rtrim($path, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR;
        $folders = [];

        if (is_dir($path)) {
            if ($handle = opendir($path)) {
                while (false !== ($entry = readdir($handle))) {
                    if ($entry !== '.' && $entry !== '..') {
                        $fullPath = $path . $entry;
                        if (is_dir($fullPath)) {
                            $folders[] = $entry;
                        }
                    }
                }
                closedir($handle);
            }
        }

        return $folders;
    }
}